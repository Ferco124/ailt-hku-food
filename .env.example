# Copy to .env before editing. Nothing here is needed for a local run.
# macOS reserves 5000 and 7000 for AirPlay Receiver, so the app defaults to 4173.
PORT=4173

# Model provider. Server-side only; the key is never sent to the browser or
# written into a packaged release.
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://api.deepseek.com/v1
BAILIAN_MODEL=deepseek-chat
LLM_TIMEOUT_MS=12000

# Public hosting (docs/SELF_HOST.md). Leave these alone unless the server is
# being put behind a tunnel or reverse proxy.

# 127.0.0.1 keeps the server off the network. A tunnel reaches it from the same
# machine, so a public deployment still binds loopback.
HOST=127.0.0.1

# 1 only when every request arrives through a proxy that sets the client
# address (cloudflared). On a directly reachable server the header could be
# forged, which would turn the per-visitor limit into a suggestion.
TRUST_PROXY=0

# Requests accepted per Hong Kong day before /api/recommend starts returning
# 429. This bounds what a stranger can spend of your model credit. 0 = no cap.
DAILY_REQUEST_BUDGET=300

# Required to read /api/stats once TRUST_PROXY=1; without it the route is a 404.
# Any long random string, for example: openssl rand -hex 24
STATS_TOKEN=