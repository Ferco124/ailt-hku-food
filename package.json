{
  "name": "hku-canteen-finder",
  "version": "1.0.0",
  "private": true,
  "description": "HKU Canteen Finder — natural-language canteen recommendations demo",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "migrate": "node --disable-warning=ExperimentalWarning scripts/migrate.mjs",
    "db:reset": "node --disable-warning=ExperimentalWarning scripts/migrate.mjs --reset",
    "check-key": "node scripts/check-key.mjs",
    "test": "node --test \"tests/*.test.js\"",
    "evaluate": "node scripts/evaluate.mjs",
    "cache:walkthrough": "node scripts/cache-walkthrough.mjs",
    "package": "node scripts/package.mjs"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
